{
  "name": "mermail-relayer-sentinel",
  "version": "1.0.0",
  "description": "Autonomous Relayer Gas & Treasury Liquidity Sentinel for Mermail Agent Skills",
  "type": "module",
  "main": "src/sentinel-agent.js",
  "bin": {
    "mermail-agent": "bin/cli.js",
    "mermail-sentinel": "bin/cli.js"
  },
  "scripts": {
    "start": "node bin/cli.js",
    "agent": "node bin/cli.js",
    "serve": "node src/server.js",
    "live": "node src/server.js",
    "tunnel": ".\\cloudflared.exe tunnel --url http://localhost:3333",
    "demo": "node demo/run-demo.mjs",
    "doctor": "node bin/cli.js doctor",
    "reset": "node bin/cli.js reset",
    "setup": "node bin/cli.js doctor",
    "test": "node --test tests/**/*.test.mjs",
    "test:skill": "node tests/validate-skill.mjs",
    "validate": "node tests/validate-skill.mjs && node --test tests/**/*.test.mjs"
  },
  "keywords": [
    "mermail",
    "agent-skill",
    "paybox",
    "solana",
    "web3",
    "relayer",
    "gas-sentinel",
    "treasury",
    "superteam",
    "mcp"
  ],
  "author": "Mermail Relayer Sentinel Builders",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
