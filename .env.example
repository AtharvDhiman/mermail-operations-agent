# Mermail API Key (Starts with sk-proj-)
# Note: For PayBox wallet operations, prefer full-profile MCP OAuth (https://console.mermail.app/mcp)
MERMAIL_API_KEY=sk-proj-your-workspace-api-key

# Mermail MCP Server Endpoint
MERMAIL_MCP_URL=https://console.mermail.app/mcp

# Optional mailbox public_id or address (if not set, auto-discovers active mailbox)
MERMAIL_MAILBOX_ID=mbx_ops_sentinel_01

# Operational Safety Config
SENTINEL_DAILY_MAX_USD_CAP=500
SENTINEL_MAX_SINGLE_TOPUP_USD=100
SENTINEL_ENV=simulation
SENTINEL_ALLOWLIST_PATH=./config/relayers.json
